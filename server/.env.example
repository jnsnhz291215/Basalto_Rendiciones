# Copiar a server/.env y completar valores reales.
# La API carga este archivo al arrancar (dotenv).

# Gemini (verificación de comprobantes)
GEMINI_ENABLED=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Opcional, separados por coma:
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-1.5-flash

# Flags temporales Dev (off por defecto; poner en 1 solo para pruebas locales)
DEV_RUT_BYPASS=0
# DEV_RUT_CLEAN=211919116
DEV_HARD_DELETE=0
DEV_COMPROBANTE_VERIFY_BYPASS=0
